# Copy to .env and adjust. docker compose reads .env automatically.

POSTGRES_DB=routine
POSTGRES_USER=routine
POSTGRES_PASSWORD=routine
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=3000

# Base64-encoded HMAC key of at least 256 bits. Generate one with:
#   openssl rand -base64 48
# Leave blank in development to use the built-in dev key. REQUIRED in production.
ROUTINE_JWT_SECRET=

ROUTINE_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
