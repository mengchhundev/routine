# Supply-chain hardening for every npm command run in this project, locally,
# in Docker and in CI.

# Only the official registry, even if a user-level .npmrc points elsewhere.
registry=https://registry.npmjs.org/

# No dependency runs code when it is installed. None of the current ones need
# to (checked with `npm query ":attr(scripts, [postinstall])"`); a future one
# that does fails the build visibly instead of running silently.
ignore-scripts=true

# Exact versions in package.json, so an update is always a reviewed diff.
save-exact=true
