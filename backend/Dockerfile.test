# Test runner. The source tree and the Maven cache are mounted at run time, so
# this image only needs the toolchain and a warm dependency set.
FROM maven:3-eclipse-temurin-24@sha256:a137a467ec89b5713d0be817b55bdba6b4d6ef16e3d05565a79bc08d8e775a1c
WORKDIR /app

COPY pom.xml .
COPY .mvn .mvn
RUN mvn -B -q dependency:go-offline

CMD ["mvn", "-B", "test"]
