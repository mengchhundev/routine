# Test runner. The source tree and the Maven cache are mounted at run time, so
# this image only needs the toolchain and a warm dependency set.
FROM maven:3.9-eclipse-temurin-26@sha256:b2c1ad85954592f9928e84327c65201f308ad9b5d8ed7d5b823717c97bf23fbb
WORKDIR /app

COPY pom.xml .
COPY .mvn .mvn
RUN mvn -B -q dependency:go-offline

CMD ["mvn", "-B", "test"]
