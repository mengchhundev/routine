# Test runner. The source tree and the Maven cache are mounted at run time, so
# this image only needs the toolchain and a warm dependency set.
FROM maven:3-eclipse-temurin-26@sha256:4e980a3c7def35292c12ce1a1dc7872f02165f11717204c7b1c2dc477e40c1b8
WORKDIR /app

COPY pom.xml .
COPY .mvn .mvn
RUN mvn -B -q dependency:go-offline

CMD ["mvn", "-B", "test"]
