# Test runner. The source tree and the Maven cache are mounted at run time, so
# this image only needs the toolchain and a warm dependency set.
FROM maven:3.9-eclipse-temurin-21@sha256:82e2ff483b3d5a95c351379f50aff9b50263579117c2b1c090dc7cfcce6216fb
WORKDIR /app

COPY pom.xml .
COPY .mvn .mvn
RUN mvn -B -q dependency:go-offline

CMD ["mvn", "-B", "test"]
